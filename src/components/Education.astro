---
import type { CvContent } from '../data/cv';

interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const { education } = content;
---

<section class="section" id="education">
  <div class="wrap section-grid">
    <div class="section-head">
      <span class="section-index">{education.index}</span>
      <h2 class="section-title">{education.title}</h2>
    </div>

    <div class="section-body" data-reveal>
      <div class="education-grid">
        <div class="education-school">
          <h3 class="edu-school">{education.school}</h3>
          <p class="edu-program">{education.program}</p>
          <p class="edu-faculty">{education.faculty}</p>
          <p class="edu-status">{education.status}</p>
        </div>

        <div class="education-languages">
          <h3 class="skill-label">{education.languagesLabel}</h3>
          <dl class="lang-list">
            {education.languages.map((language) => (
              <div class="lang-row">
                <dt>{language.label}</dt>
                <dd>{language.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
