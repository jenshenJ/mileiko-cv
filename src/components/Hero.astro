---
import type { CvContent } from '../data/cv';

interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const { hero } = content;
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-top">
      <span class="eyebrow">{hero.eyebrow}</span>
      <span class="status">
        <span class="status-mark" aria-hidden="true"></span>
        {hero.status}
      </span>
    </div>

    <h1 class="hero-name">
      <span class="hero-name-line">{hero.name[0]}</span>
      <span class="hero-name-line">
        {hero.name[1]}<span class="hero-name-dot" aria-hidden="true">.</span>
      </span>
    </h1>

    <div class="hero-grid">
      <div class="hero-intro">
        <p class="hero-role">{hero.role}</p>
        <p class="hero-bio">{hero.bio}</p>
        <p class="hero-meta">
          {hero.meta.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      </div>

      <ul class="hero-contacts">
        {hero.contacts.map((contact) => (
          <li>
            <a
              href={contact.href}
              target={contact.href.startsWith('http') ? '_blank' : undefined}
              rel={contact.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span class="hero-contact-label">{contact.label}</span>
              <span class="hero-contact-value">{contact.value}</span>
              <span class="hero-contact-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <dl class="hero-facts">
      {hero.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
