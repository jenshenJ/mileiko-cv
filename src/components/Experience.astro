---
import type { CvContent } from '../data/cv';

interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const { experience } = content;
---

<section class="section" id="experience">
  <div class="wrap section-grid">
    <div class="section-head">
      <span class="section-index">{experience.index}</span>
      <h2 class="section-title">{experience.title}</h2>
      <span class="section-note">{experience.note}</span>
    </div>

    <div class="section-body">
      <div class="jobs">
        {experience.jobs.map((job, index) => (
          <article
            class="job"
            data-reveal
            style={`--delay:${Math.min(index, 5) * 60}ms`}
          >
            <div class="job-meta">
              <span class="job-period">{job.period}</span>
              <span class="job-duration">{job.duration}</span>
            </div>

            <div class="job-main">
              <h3 class="job-role">{job.role}</h3>
              <p class="job-company">{job.company}</p>

              <ul class="job-summary">
                {job.summary.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              <p class="job-stack">{job.stack}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
